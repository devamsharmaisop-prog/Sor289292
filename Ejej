			math.floor(
				os.clock() - startTime
			)

		local hours =
			math.floor(
				elapsed / 3600
			)

		local minutes =
			math.floor(
				(elapsed % 3600) / 60
			)

		local seconds =
			elapsed % 60

		SessionButton.Text =
			string.format(
				"TIME PLAYED : %02d:%02d:%02d",
				hours,
				minutes,
				seconds
			)

		task.wait(1)

	end

end)

