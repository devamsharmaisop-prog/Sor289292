local function giveTestSword()

	local backpack =
		LocalPlayer:WaitForChild("Backpack")

	if backpack:FindFirstChild("H101 Sword")
		or (Character and Character:FindFirstChild("H101 Sword")) then
		return
	end

	local sword =
		Instance.new("Tool")

	sword.Name = "H101 Sword"
	sword.ToolTip = "HACKER 101 test sword"

	sword.RequiresHandle = true
	sword.CanBeDropped = false

	local handle =
		Instance.new("Part")

	handle.Name = "Handle"
	handle.Size =
		Vector3.new(.35,4,.35)

	handle.Material =
		Enum.Material.Neon

	handle.Color =
		Color3.fromRGB(0,255,80)

	handle.CanCollide = false
	handle.Massless = true

	handle.Parent = sword

	sword.Activated:Connect(function()

		local grip =
			sword.Grip

		sword.Grip =
			grip *
			CFrame.Angles(
				math.rad(-60),0,0
			)

		task.wait(.12)

		if sword.Parent then
			sword.Grip = grip
		end

	end)

	sword.Parent = backpack

end

