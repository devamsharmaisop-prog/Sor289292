end

local function visualMode(mode)

	if mode == "DARK" then

		ColorCorrection.Brightness = -.1
		ColorCorrection.Contrast = .35
		ColorCorrection.Saturation = -.25

	elseif mode == "LIGHT" then

		ColorCorrection.Brightness = .15
		ColorCorrection.Contrast = 0
		ColorCorrection.Saturation = .1

	elseif mode == "HORROR" then

		ColorCorrection.Brightness = -.2
		ColorCorrection.Contrast = .6
		ColorCorrection.Saturation = -.6

	elseif mode == "CYBER" then

		ColorCorrection.Brightness = 0
		ColorCorrection.Contrast = .45
		ColorCorrection.Saturation = .4

	elseif mode == "NORMAL" then

		ColorCorrection.Brightness = 0
		ColorCorrection.Contrast = 0
		ColorCorrection.Saturation = 0

	end

end

