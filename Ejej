	UDim.new(0,8)

local function executeCommand(command)

	command =
		command
		:gsub("^%s+","")
		:gsub("%s+$","")

	local cmd,arg =
		command:match(
			"^(%S+)%s*(.*)$"
		)

	if not cmd then
		return
	end

	cmd = cmd:lower()

	local n = tonumber(arg)

	if cmd == "speed" and n then

		speedValue =
			math.clamp(n,1,150)

		speedEnabled = true

	elseif cmd == "jump" and n then

		jumpValue =
			math.clamp(n,1,150)

		jumpEnabled = true

	elseif cmd == "hipheight" and n then

		hipValue =
			math.clamp(n,0,20)

	elseif cmd == "gravity" and n then

		gravityValue =
			math.clamp(n,0,500)

		Workspace.Gravity =
			gravityValue

	elseif cmd == "fov" and n then

		fovValue =
			math.clamp(n,30,120)

		if Workspace.CurrentCamera then

			Workspace.CurrentCamera.FieldOfView =
				fovValue

		end

	elseif cmd == "noclip" then

		noclipEnabled = true

	elseif cmd == "clip" then

		noclipEnabled = false

	elseif cmd == "infinitejump" then

		infiniteJumpEnabled = true

	elseif cmd == "sit" then

		if Humanoid then
			Humanoid.Sit = true
		end

	elseif cmd == "stand" then

		if Humanoid then
			Humanoid.Sit = false
		end

	elseif cmd == "sword" then

		giveTestSword()

	elseif cmd == "teleporttool" then

		giveTeleportTool()

	elseif cmd == "dark" then

		visualMode("DARK")

	elseif cmd == "light" then

		visualMode("LIGHT")

	elseif cmd == "horror" then

		visualMode("HORROR")

	elseif cmd == "cyber" then

		visualMode("CYBER")

	elseif cmd == "normal" then

		visualMode("NORMAL")

	elseif cmd == "reset" then

		if Humanoid then
			Humanoid.Health = 0
		end

	end

end

makeButton(
