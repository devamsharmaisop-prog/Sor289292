--========================================================
-- OPEN / CLOSE
--========================================================

local opening = false
local closing = false

local function openMenu()

	if opening then
		return
	end

	opening = true

	Floating.Visible = false

	Main.Visible = true

	Main.Size =
		UDim2.new(0,0,0,0)

	TweenService:Create(
		Main,
		TweenInfo.new(
			.3,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size =
				UDim2.new(0,470,0,340)
		}
	):Play()

	task.delay(.32,function()
		opening = false
	end)

end

function closeMenu()

	if closing then
		return
	end

	closing = true

	TweenService:Create(
		Main,
		TweenInfo.new(
			.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		),
		{
			Size =
				UDim2.new(0,0,0,0)
		}
	):Play()

	task.delay(.27,function()

		Main.Visible = false

		-- IMPORTANT:
		-- There is NO Matrix layer here.
		-- Therefore nothing can cover the screen
		-- with 101010101010.

		Floating.Visible = true

		Floating.Size =
			UDim2.new(0,0,0,0)

		TweenService:Create(
			Floating,
			TweenInfo.new(
				.3,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{
				Size =
					UDim2.new(0,58,0,58)
			}
		):Play()

		closing = false

	end)

end

Close.MouseButton1Click:Connect(closeMenu)
Minimize.MouseButton1Click:Connect(closeMenu)

