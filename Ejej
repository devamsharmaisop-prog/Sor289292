local function createParticle()

	local p = Instance.new("TextLabel")

	p.BackgroundTransparency = 1

	p.Text =
		math.random(1,2) == 1
		and "1"
		or "0"

	p.TextColor3 =
		Color3.fromRGB(
			0,
			math.random(180,255),
			math.random(60,120)
		)

	p.Font = Enum.Font.Code
	p.TextSize = math.random(10,18)

	p.Size =
		UDim2.fromOffset(20,20)

	p.Position =
		UDim2.fromScale(
			math.random(5,95)/100,
			math.random(5,95)/100
		)

	p.TextTransparency = 0.25
	p.ZIndex = 2

	p.Parent = ParticleLayer

	TweenService:Create(
		p,
		TweenInfo.new(
			math.random(15,30)/10,
			Enum.EasingStyle.Linear
		),
		{
			TextTransparency = 1,
			Position =
				UDim2.new(
					p.Position.X.Scale,
					0,
					p.Position.Y.Scale - .12,
					0
				)
		}
	):Play()

	task.delay(3,function()

		if p then
			p:Destroy()
		end

	end)

end

task.spawn(function()

	while GUI.Parent do

		if ParticleLayer.Visible then
			createParticle()
		end

		task.wait(.25)

	end

end)

